<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 模板：ops/install-bridge.sh 替换 __HOME__ / __REPO__ 后装到 ~/Library/LaunchAgents/ -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agentos.bridge</string>
  <key>ProgramArguments</key>
  <array>
    <!-- caffeinate：桥接服务在跑时阻止闲置睡眠（-i）和插电时的系统睡眠（-s）；合盖仍会睡 -->
    <string>/usr/bin/caffeinate</string>
    <string>-is</string>
    <string>__HOME__/.agentos/venv/bin/python</string>
    <string>__REPO__/ops/bridge/bridge.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/.agentos/logs/bridge.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.agentos/logs/bridge.log</string>
</dict>
</plist>
