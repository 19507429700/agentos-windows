<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 模板：ops/install-collectors.sh 替换 __HOME__ / __REPO__ 后装到 ~/Library/LaunchAgents/ -->
<!-- 个人自用：读本机已解密的微信库（密钥在你家目录），以你本人账号运行 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agentos.collect-wechat</string>
  <key>ProgramArguments</key>
  <!-- 经 run-job.sh 启动：失败/超时告警到飞书和微信，成功去 healthchecks 打卡 -->
  <!-- 用专用 Python（python3.14 的独立拷贝，zstd 解压要 3.14）：只有它被授予「完全磁盘访问权限」读微信目录，
       平时的 python3.14 拿不到这个权限。由 install-collectors.sh 建在 ~/.agentos/wechat-python/ -->
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/ops/run-job.sh</string>
    <string>collect-wechat</string>
    <string>8</string>
    <string>--</string>
    <string>__HOME__/.agentos/wechat-python/bin/python3.14</string>
    <string>__REPO__/ops/collect_wechat.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
  <!-- 每 10 分钟增量采集（和飞书、邮箱一致）；Mac 睡眠错过的，醒来后补跑一次 -->
  <key>StartInterval</key>
  <integer>600</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/.agentos/logs/collect-wechat.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.agentos/logs/collect-wechat.log</string>
</dict>
</plist>
