<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 模板：ops/install-collectors.sh 替换 __HOME__ / __REPO__ 后装到 ~/Library/LaunchAgents/ -->
<!-- 提取文字：原文里的图片识字、PDF / Word / PPT 取正文，存成旁边的 .txt，让检索也能搜到 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agentos.extract-text</string>
  <key>ProgramArguments</key>
  <!-- 经 run-job.sh 启动：失败/超时告警到飞书和微信，成功去 healthchecks 打卡 -->
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/ops/run-job.sh</string>
    <string>extract-text</string>
    <string>8</string>
    <string>--</string>
    <string>/usr/bin/python3</string>
    <string>__REPO__/ops/extract_text.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
  <!-- 每 10 分钟一轮，每轮最多做 4 分钟；新采进来的图片和文件最多十几分钟后就能搜到 -->
  <key>StartInterval</key>
  <integer>600</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/.agentos/logs/extract-text.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.agentos/logs/extract-text.log</string>
</dict>
</plist>
